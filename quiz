  "cld-devops":     { people:  0, verify:  1, ops:  2, breadth:  0 },
  "cld-sysadmin":   { people:  1, verify:  0, ops:  2, breadth:  0 }
};
 
/* THE KNOB. How much the track matters relative to working style.
     1.5  close to the old behavior: 3 roles from one track
     0.9  current
     0.3  track barely matters
   Take the quiz at two or three values and pick the one whose results
   you would actually defend to a student. */
const TRACK_WEIGHT = 0.9;
 
 
/* ---------------------------------------------------------------------
   3. SCORING
   --------------------------------------------------------------------- */
 
/* Mean and standard deviation of each key under random answering.
   Each question is an independent draw, so means add and variances add.
   That makes this exact rather than simulated.
 
   This is what puts the tracks on equal footing. Note it reads QUIZ
   AFTER the push above, so it covers all 17 questions -- and it
   recomputes whenever you edit a question, with no manual work. */
function keyStats(keys, field) {
  const stats = {};
  for (const key in keys) {
    let mean = 0, variance = 0;
    for (const q of QUIZ) {
      const vals = q.options.map(o => (o[field] || {})[key] || 0);
      const m = vals.reduce((a, b) => a + b, 0) / vals.length;
      variance += vals.reduce((a, b) => a + (b - m) ** 2, 0) / vals.length;
      mean += m;
    }
    stats[key] = { mean, sd: Math.sqrt(variance) || 1 };
  }
  return stats;
}
 
const TRACK_STATS = keyStats(BASE_SCORES, "d");
const DIM_STATS   = keyStats(DIMS, "dim");
 
/* Overrides the original. Returns raw points (still worth showing the
   student) plus z-scores, which are what you actually rank on. */
function scoreQuiz() {
  const raw = Object.assign({}, BASE_SCORES);
  const rawDim = Object.assign({}, DIMS);
 
  quizState.answers.forEach((choice, qi) => {
    if (choice == null || !QUIZ[qi]) return;
    const opt = QUIZ[qi].options[choice];
    for (const t in (opt.d || {}))   if (t in raw)    raw[t] += opt.d[t];
    for (const k in (opt.dim || {})) if (k in rawDim) rawDim[k] += opt.dim[k];
  });
 
  const z = {}, pct = {}, dimZ = {};
  for (const t in raw) {
    z[t] = (raw[t] - TRACK_STATS[t].mean) / TRACK_STATS[t].sd;
    // z of -2 to +2 covers almost everyone; clamp keeps bars in range
    pct[t] = Math.round(Math.max(0, Math.min(100, ((z[t] + 2) / 4) * 100)));
  }
  for (const k in rawDim) {
    dimZ[k] = (rawDim[k] - DIM_STATS[k].mean) / DIM_STATS[k].sd;
  }
 
  return { raw, z, pct, dimZ };
}
 
/* Rank all 15 roles: track fit plus how well the student's working style
   matches the role's profile. Dot product, so a student who is strongly
   +verify matches a strongly +verify role. Divided by 4 so a single
   dimension cannot swamp the track score. */
function scoreRoles(trackZ, dimZ) {
  return Object.keys(ROLE_PROFILE).map(roleId => {
    const profile = ROLE_PROFILE[roleId];
    const track = ROLES[roleId].track;
    let styleFit = 0;
    for (const dim in profile) styleFit += (dimZ[dim] || 0) * profile[dim];
    styleFit /= 4;
    return {
      id: roleId,
      track: track,
      fit: TRACK_WEIGHT * (trackZ[track] || 0) + styleFit
    };
  }).sort((a, b) => b.fit - a.fit);
}
 
/* Top 3, capped at 2 per track so students see a real spread rather than
   three variations of the same job. Set maxPerTrack to 3 to remove the
   cap -- it is a judgment call, not a correctness fix. */
function topThreeRoles(trackZ, dimZ, maxPerTrack) {
  if (maxPerTrack == null) maxPerTrack = 2;
  const picked = [], counts = {};
  for (const r of scoreRoles(trackZ, dimZ)) {
    if ((counts[r.track] || 0) >= maxPerTrack) continue;
    picked.push(r);
    counts[r.track] = (counts[r.track] || 0) + 1;
    if (picked.length === 3) break;
  }
  return picked;
}
 
 
/* ---------------------------------------------------------------------
   4. RESULTS
 
   Overrides the original. Three changes:
     - ranks on z, not raw points, so tracks compete fairly
     - bars use an absolute scale, so a close result LOOKS close
     - recommends 3 specific roles instead of one track's fixed three
   --------------------------------------------------------------------- */
 
function renderResults() {
  const scored = scoreQuiz();
  const z = scored.z, raw = scored.raw, pct = scored.pct, dimZ = scored.dimZ;
 
  const ranked = TRACKS.map(t => ({ t: t, z: z[t.id], raw: raw[t.id], pct: pct[t.id] }))
                       .sort((a, b) => b.z - a.z);
  const answered = quizState.answers.filter(a => a != null).length;
 
  if (!answered) {
    return `<div class="wrap"><div class="page-head"><h1>No answers yet</h1>
      <p>Take the quiz first and your results will show up here.</p></div>
      <a class="btn btn-primary" href="#/quiz">Start the quiz</a></div>`;
  }
 
  const bars = ranked.map((r, i) => `
    <div class="bar-row${i === 0 ? " top" : ""}">
      <span class="nm">${esc(r.t.name)}</span>
      <span class="bar-track"><i style="width:${Math.max(r.pct, 3)}%"></i></span>
      <span class="pct">${r.raw > 0 ? "+" : ""}${r.raw}</span>
    </div>`).join("");
 
  const top = ranked[0].t;
  const second = ranked[1].t;
  const closeCall = (ranked[0].z - ranked[1].z) < 0.5;
 
  const roles = topThreeRoles(z, dimZ);
  const spread = new Set(roles.map(r => r.track)).size > 1;
 
  return `
  <div class="wrap">
    <div class="result-hero">
      <div>
        <span class="eyebrow">Your result &#183; ${answered} of ${QUIZ.length} answered</span>
        <h1>${esc(top.full)}</h1>
        <p>${esc(top.blurb)}</p>
        ${closeCall ? `<p style="margin-top:14px;font-size:15px">Your runner-up was <strong>${esc(second.full)}</strong>, and it was close &mdash; worth taking seriously. Plenty of people move between these two tracks.</p>` : ""}
        <div class="hero-cta" style="margin-top:20px">
          <a class="btn btn-ghost btn-sm" href="#/careers/${top.id}">Read the full track</a>
          <a class="btn btn-ghost btn-sm" href="#/quiz" data-quiz="restart">Retake the quiz</a>
        </div>
      </div>
      <div>
        <h3 style="font-family:var(--mono);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);margin-bottom:14px">How the five tracks scored</h3>
        <div class="bars">${bars}</div>
        <p style="font-size:12.5px;color:var(--muted);margin-top:14px;font-family:var(--mono);line-height:1.6">Each track is scored against its own range, so they compete on equal footing. Bar length is an absolute position &mdash; close bars mean a close result.</p>
      </div>
    </div>
 
    <div class="page-head" style="margin-top:44px">
      <span class="eyebrow">Your three closest roles</span>
      <h1 style="font-size:1.9rem">Start with these titles</h1>
      <p>${spread
        ? "These come from more than one track, because how you want to work matters as much as what you want to work on."
        : "Your answers pointed consistently at one track, so all three sit inside it."}</p>
    </div>
    ${roles.map((r, i) => roleBlock(r.id, i + 1, true)).join("")}
 
    <div class="band">
      <div>
        <h2>Practice before the STEM fair</h2>
        <p>Every role has seven real questions &mdash; three behavioral, four technical &mdash; with a model answer and a checklist of what the interviewer is listening for.</p>
      </div>
      <a class="btn btn-primary" href="#/prep">Open interview prep</a>
    </div>
  </div>`;
}
 
 
