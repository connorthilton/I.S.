/* ---------------------------------------------------------------------
   2. ROLE PROFILES
 
   >>> THESE ARE EDITORIAL, NOT CODE. <<<
 
   Each role's target on the four dimensions, -2 to +2. They were derived
   from the role descriptions you wrote above -- SDET is +2 verify because
   your own text says "you think adversarially"; Consultant is +2 breadth
   because your text says you see many companies fast.
 
   They encode real claims about these careers. Changing a number changes
   who gets recommended what. Disagree freely.
 
   Note: dta-scientist is near-neutral on all four, so it can only win on
   track score. If you think the statistics focus makes it a +verify role,
   say so here.
   --------------------------------------------------------------------- */
 
const ROLE_PROFILE = {
  "swe-fullstack":  { people: -1, verify: -1, ops:  0, breadth: -1 },
  "swe-frontend":   { people:  0, verify: -1, ops: -1, breadth: -1 },
  "swe-sdet":       { people:  0, verify:  2, ops:  0, breadth:  0 },
 
  "dta-analyst":    { people:  1, verify:  1, ops: -1, breadth:  1 },
  "dta-eng":        { people: -1, verify:  1, ops:  1, breadth: -1 },
  "dta-scientist":  { people:  0, verify:  0, ops: -1, breadth:  0 },
 
  "bsa-analyst":    { people:  2, verify:  0, ops: -2, breadth:  0 },
  "bsa-apm":        { people:  2, verify: -1, ops: -1, breadth:  0 },
  "bsa-consultant": { people:  2, verify:  0, ops: -2, breadth:  2 },
 
  "sec-soc":        { people: -1, verify:  1, ops:  2, breadth:  0 },
  "sec-grc":        { people:  1, verify:  2, ops: -2, breadth:  1 },
  "sec-pentest":    { people:  0, verify:  2, ops: -1, breadth:  1 },
 
